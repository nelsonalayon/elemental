generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model independence {
  idPago                                Int       @id @default(autoincrement()) @db.TinyInt
  referenciApto                         String?   @db.VarChar(45)
  persona                               String?   @db.VarChar(45)
  concepto                              String?   @db.VarChar(45)
  fechaPago                             DateTime? @db.Date
  valorEsperado                         Int?
  valorPagado                           Int?
  consignacion                          String?   @db.VarChar(45)
  persona_independence_personaTopersona persona?  @relation("independence_personaTopersona", fields: [persona], references: [idPersona], onDelete: NoAction, onUpdate: NoAction, map: "idPersona")
  apto                                  apto?     @relation(fields: [referenciApto], references: [idapto], onDelete: NoAction, onUpdate: NoAction, map: "referenciApto")

  @@index([referenciApto], map: "idApto_idx")
  @@index([persona], map: "idPersona_idx")
  @@map("1independence")
}

model freedom {
  idPago        Int       @id @default(autoincrement()) @db.TinyInt
  referenciApto String?   @db.VarChar(45)
  persona       String?   @db.VarChar(45)
  concepto      String?   @db.VarChar(45)
  fechaPago     DateTime? @db.Date
  valorEsperado Int?
  valorPagado   Int?
  consignacion  String?   @db.VarChar(45)

  @@index([persona], map: "persona_idx")
  @@index([referenciApto], map: "referenciApto_idx")
  @@map("2freedom")
}

model apto {
  idapto           String         @id @db.VarChar(30)
  nombre           String?        @db.VarChar(45)
  valor            Int?
  cuota_inicial    Int?           @map("cuota inicial")
  fecha_de_entrega DateTime?      @map("fecha de entrega") @db.Date
  linkConsignacion String?        @db.VarChar(45)
  independence     independence[]
}

model persona {
  idPersona                                  String         @id @db.VarChar(20)
  nombre                                     String?        @db.VarChar(45)
  email                                      String?        @db.VarChar(45)
  independence_independence_personaTopersona independence[] @relation("independence_personaTopersona")
}
